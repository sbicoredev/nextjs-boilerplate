{
  "name": "nextjs-boilerplate",
  "version": "0.0.1",
  "description": "Next.js boilerplate",
  "author": "Sajid",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "bash scripts/start-standalone.sh",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "docker:up": "docker compose --env-file .env.docker up -d",
    "docker:down": "docker compose --env-file .env.docker down",
    "ui:add": "pnpm dlx shadcn@latest add",
    "docker:build": "docker build -t nextjs-boilerplate .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env nextjs-boilerplate",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-serif": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-form": "^1.33.4",
    "@tanstack/react-query": "^5.101.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "motion": "^13.0.0",
    "next": "^16.3.0",
    "next-safe-action": "^8.6.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.2",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "ultracite": "7.10.2",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "ultracite fix"
    ]
  }
}
