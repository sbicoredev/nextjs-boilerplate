NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Acme

# --- Database ---
DB_URL=postgresql://postgres:postgres-pass@127.0.0.1:5432/acme

# --- AUTH ---
BETTER_AUTH_SECRET="your-secret"
BETTER_AUTH_URL=http://localhost:3000  # Base URL of your app
AUTH_OTP_EXPIRES=300  # in seconds (default 5 min)
AUTH_OTP_ALLOWED_ATTEMPT=5 # The maximum number of attempts allowed for verifying an OTP. Defaults to 3
# google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --- Email ---
SMTP_SERVER_HOST=localhost
SMTP_SERVER_PORT=1025
SMTP_SERVER_USERNAME=user
SMTP_SERVER_PASSWORD=pass
EMAIL_FROM="Acme <hello@acme.app>"

# --- Upstash (RATE_LIMIT_BACKEND=upstash, the default) ---
UPSTASH_REDIS_REST_URL=http://localhost:8080
UPSTASH_REDIS_REST_TOKEN=your-secret-token # should match `upstash:dev` command's URS_TOKEN env var for local development
# rate limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=upstash # "upstash" (hosted, REST) or "redis" (self-hosted, see docker-compose.yaml's `redis` service)
# REDIS_URL=redis://localhost:6379 # only needed when RATE_LIMIT_BACKEND=redis
RATE_LIMIT_TTL=60 # Time window for rate limiting (seconds)
RATE_LIMIT_MAX=5 # How many requests a user can make in each time window.
AUTH_RATE_LIMIT_TTL=60 # Time window for auth routes rate limiting (seconds)
AUTH_RATE_LIMIT_MAX=5 # How many requests a user can make in each auth routes time window.
