NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Acme

# --- Database ---
DB_URL=postgresql://postgres:postgres-pass@127.0.0.1:5432/acme

# --- AUTH ---
BETTER_AUTH_SECRET="your-secret"
BETTER_AUTH_URL=http://localhost:3000  # Base URL of your app
# google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --- Email ---
SMTP_SERVER_HOST=localhost
SMTP_SERVER_PORT=1025
SMTP_SERVER_USERNAME=user
SMTP_SERVER_PASSWORD=pass
EMAIL_FROM="Acme <no-reply@acme.com>"

# --- Rate limiting (Upstash Redis) ---
# Local dev: points at the redis-http-proxy service in
# docker/docker-compose.dev.yml (a REST shim in front of plain Redis —
# see docs/LOCAL-SERVICES.md for why that's needed). Production: your
# real Upstash REST URL/token from the Upstash console.
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-dev-token-not-for-production
# rate limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TTL=10 # Time window for rate limiting (seconds)
RATE_LIMIT_MAX=30 # How many requests a user can make in each time window.
AUTH_RATE_LIMIT_TTL=10 # Time window for auth routes rate limiting (seconds)
AUTH_RATE_LIMIT_MAX=30 # How many requests a user can make in each auth routes time window.
